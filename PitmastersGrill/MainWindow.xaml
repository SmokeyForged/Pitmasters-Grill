<Window x:Class="PitmastersGrill.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PitmastersGrill"
        xmlns:views="clr-namespace:PitmastersGrill.Views"
        mc:Ignorable="d"
        Title="Pitmasters Grill"
        Height="571"
        Width="760"
        MinHeight="300"
        MinWidth="420"
        Icon="Assets/PMGIcon.ico"
        Background="{DynamicResource WindowBackgroundBrush}"
        PreviewKeyDown="Window_PreviewKeyDown"
        LocationChanged="Window_LocationChanged"
        SizeChanged="Window_SizeChanged"
        StateChanged="Window_StateChanged">

    <Window.Resources>
        <local:ThreatCynoHullHighlightConverter x:Key="ThreatCynoHullHighlightConverter" />
        <local:LastShipMatchesCynoHullConverter x:Key="LastShipMatchesCynoHullConverter" />

        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#1F1F1F"/>
        <SolidColorBrush x:Key="SurfaceAltBrush" Color="#252525"/>
        <SolidColorBrush x:Key="HeaderTextBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BodyTextBrush" Color="#F3F3F3"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#DDDDDD"/>
        <SolidColorBrush x:Key="GridBackgroundBrush" Color="#2B2B2B"/>
        <SolidColorBrush x:Key="GridAlternateBrush" Color="#323232"/>
        <SolidColorBrush x:Key="GridHeaderBrush" Color="#202020"/>
        <SolidColorBrush x:Key="GridLineBrush" Color="#4A4A4A"/>
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#3A3A3A"/>
        <SolidColorBrush x:Key="AccentEmberBrush" Color="#F28C28"/>
        <SolidColorBrush x:Key="AccentHotCoalBrush" Color="#D94A1E"/>
        <SolidColorBrush x:Key="AccentAshBrush" Color="#858985"/>
        <SolidColorBrush x:Key="ThreatCriticalBrush" Color="#FF3B21"/>
        <SolidColorBrush x:Key="ThreatSevereBrush" Color="#D94A1E"/>
        <SolidColorBrush x:Key="ThreatHighBrush" Color="#F28C28"/>
        <SolidColorBrush x:Key="ThreatElevatedBrush" Color="#C79035"/>
        <SolidColorBrush x:Key="ThreatLowBrush" Color="#B6A36B"/>
        <SolidColorBrush x:Key="ThreatNeutralBrush" Color="#858985"/>
        <SolidColorBrush x:Key="SuccessGreenBrush" Color="#6FBF73"/>
        <SolidColorBrush x:Key="WarningAmberBrush" Color="#F6B94B"/>
        <SolidColorBrush x:Key="ErrorRedBrush" Color="#EF5350"/>
        <SolidColorBrush x:Key="BoardSignalConfirmedCovertBrush" Color="#B48CFF"/>
        <SolidColorBrush x:Key="BoardSignalConfirmedNormalBrush" Color="#EF5350"/>
        <SolidColorBrush x:Key="BoardSignalInferredCynoBrush" Color="#F28C28"/>
        <SolidColorBrush x:Key="BoardSignalPossibleBrush" Color="#F6B94B"/>
        <SolidColorBrush x:Key="BoardSignalBaitBrush" Color="#B8915E"/>
        <SolidColorBrush x:Key="PilotNoteFlagBrush" Color="#00E5FF"/>
        <SolidColorBrush x:Key="WatchedPilotMarkerBrush" Color="#FFF4C7"/>

        <Style TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextTrimming" Value="None"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{DynamicResource GridBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource BodyTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GridLineBrush}"/>
            <Setter Property="GridLinesVisibility" Value="All"/>
            <Setter Property="RowBackground" Value="{DynamicResource GridBackgroundBrush}"/>
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource GridAlternateBrush}"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource GridLineBrush}"/>
            <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource GridLineBrush}"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource GridHeaderBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource HeaderTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GridLineBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Background" Value="{DynamicResource GridBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource BodyTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GridLineBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentEmberBrush}"/>
                    <Setter Property="BorderThickness" Value="1"/>
                </Trigger>

                <DataTrigger Binding="{Binding BoardSignalKind}" Value="Bait">
                    <Setter Property="Background" Value="{DynamicResource BoardSignalBaitBrush}"/>
                    <Setter Property="Foreground" Value="Black"/>
                </DataTrigger>

                <DataTrigger Binding="{Binding BoardSignalKind}" Value="ConfirmedCovert">
                    <Setter Property="Background" Value="{DynamicResource BoardSignalConfirmedCovertBrush}"/>
                    <Setter Property="Foreground" Value="Black"/>
                </DataTrigger>

                <DataTrigger Binding="{Binding BoardSignalKind}" Value="ConfirmedNormal">
                    <Setter Property="Background" Value="{DynamicResource BoardSignalConfirmedNormalBrush}"/>
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>

                <DataTrigger Binding="{Binding BoardSignalKind}" Value="InferredCyno">
                    <Setter Property="Background" Value="{DynamicResource BoardSignalInferredCynoBrush}"/>
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>

                <DataTrigger Binding="{Binding BoardSignalKind}" Value="Possible">
                    <Setter Property="Background" Value="{DynamicResource BoardSignalPossibleBrush}"/>
                    <Setter Property="Foreground" Value="Black"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="{DynamicResource GridBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource BodyTextBrush}"/>
            <Setter Property="ToolTip" Value="{Binding BoardHoverToolTip}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Trigger>
                <DataTrigger Binding="{Binding BoardHoverToolTip}" Value="">
                    <Setter Property="ToolTip" Value="{x:Null}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SettingsLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource BodyTextBrush}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextTrimming" Value="None"/>
        </Style>

        <Style x:Key="CompactModeToggleStyle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource BodyTextBrush}"/>
            <Setter Property="Background" Value="#0891B2"/>
            <Setter Property="BorderBrush" Value="#22D3EE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="MinWidth" Value="112"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="RootBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RootBorder" Property="BorderBrush" Value="#606060"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="#2A2A2A"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="#0F766E"/>
                                <Setter TargetName="RootBorder" Property="BorderBrush" Value="#5EEAD4"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="RootBorder" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Content" Value="Board Mode"/>
            <Setter Property="ToolTip" Value="Switch to the dense Board Mode layout."/>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Content" Value="Analysis Mode"/>
                    <Setter Property="ToolTip" Value="Switch to the expanded Analysis Mode layout."/>
                </Trigger>
            </Style.Triggers>
        </Style>



        <Style x:Key="CompactActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource BodyTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="MinWidth" Value="64"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RootBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RootBorder" Property="BorderBrush" Value="#606060"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="#2A2A2A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="RootBorder" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowControlButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource BodyTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RootBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="#2A2A2A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="RootBorder" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OpenDetailsActionButtonStyle" TargetType="Button" BasedOn="{StaticResource CompactActionButtonStyle}">
            <Setter Property="Background" Value="#0891B2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#22D3EE"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="CommandStripButtonStyle" TargetType="Button" BasedOn="{StaticResource OpenDetailsActionButtonStyle}">
            <Setter Property="MinWidth" Value="112"/>
        </Style>


        <Style x:Key="PilotNoteButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="MinWidth" Value="18"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentAshBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="ToolTip" Value="Add note"/>
        </Style>

        <Style x:Key="DetailActionLinkButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock x:Name="Text"
                                   Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                                   Foreground="{TemplateBinding Foreground}"
                                   FontWeight="{TemplateBinding FontWeight}"
                                   TextDecorations="{x:Null}"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Text" Property="TextDecorations" Value="Underline"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Text" Property="Foreground" Value="{DynamicResource ErrorRedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CompactAwareTabItemStyle" TargetType="TabItem">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Foreground" Value="{DynamicResource BodyTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabItem}">
                        <Border x:Name="TabRoot"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1,1,1,0"
                                CornerRadius="4,4,0,0"
                                Margin="0,0,2,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="HeaderContent"
                                              ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabRoot" Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
                                <Setter TargetName="TabRoot" Property="BorderBrush" Value="{DynamicResource AccentEmberBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource HeaderTextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabRoot" Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="TabRoot" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsChecked, ElementName=CompactModeToggleButton}" Value="True">
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Height" Value="0"/>
                    <Setter Property="MinHeight" Value="0"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>


    </Window.Resources>

    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                Padding="12"
                BorderBrush="{DynamicResource PanelBorderBrush}"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="WindowHeader_MouseLeftButtonDown">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsChecked, ElementName=CompactModeToggleButton}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Orientation="Vertical"
                                VerticalAlignment="Center"
                                Margin="0,0,20,0">
                        <TextBlock Text="Pitmasters Grill"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource HeaderTextBrush}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top">
                        <Button x:Name="MinimizeWindowButton"
                                Style="{StaticResource WindowControlButtonStyle}"
                                Margin="0,0,6,0"
                                ToolTip="Minimize PMG"
                                Content="_"
                                Click="MinimizeWindowButton_Click"/>
                        <Button x:Name="MaximizeRestoreWindowButton"
                                Style="{StaticResource WindowControlButtonStyle}"
                                Margin="0,0,6,0"
                                ToolTip="Maximize PMG"
                                Content="[]"
                                Click="MaximizeRestoreWindowButton_Click"/>
                        <Button x:Name="CloseWindowButton"
                                Style="{StaticResource WindowControlButtonStyle}"
                                ToolTip="Close PMG"
                                Content="X"
                                Click="CloseWindowButton_Click"/>
                    </StackPanel>

                </Grid>

                <Border Grid.Row="1"
                        Margin="0,12,0,0"
                        Padding="8,5"
                        Background="{DynamicResource SurfaceAltBrush}"
                        BorderBrush="{DynamicResource PanelBorderBrush}"
                        BorderThickness="1">
                    <WrapPanel VerticalAlignment="Center">
                        <TextBlock Text="Sig:"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   VerticalAlignment="Center"
                                   FontSize="11"
                                   Margin="0,0,8,0"/>

                        <Border Width="12"
                                Height="12"
                                Background="{DynamicResource BoardSignalConfirmedCovertBrush}"
                                BorderBrush="{DynamicResource GridLineBrush}"
                                BorderThickness="1"
                                Margin="0,0,4,0"/>
                        <TextBlock Text="✦ confirmed covert"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   VerticalAlignment="Center"
                                   FontSize="11"
                                   Margin="0,0,10,0"/>

                        <Border Width="12"
                                Height="12"
                                Background="{DynamicResource BoardSignalConfirmedNormalBrush}"
                                BorderBrush="{DynamicResource GridLineBrush}"
                                BorderThickness="1"
                                Margin="0,0,4,0"/>
                        <TextBlock Text="◆ confirmed normal"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   VerticalAlignment="Center"
                                   FontSize="11"
                                   Margin="0,0,10,0"/>

                        <Border Width="12"
                                Height="12"
                                Background="{DynamicResource BoardSignalInferredCynoBrush}"
                                BorderBrush="{DynamicResource GridLineBrush}"
                                BorderThickness="1"
                                Margin="0,0,4,0"/>
                        <TextBlock Text="! inferred"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   VerticalAlignment="Center"
                                   FontSize="11"
                                   Margin="0,0,10,0"/>

                        <Border Width="12"
                                Height="12"
                                Background="{DynamicResource BoardSignalPossibleBrush}"
                                BorderBrush="{DynamicResource GridLineBrush}"
                                BorderThickness="1"
                                Margin="0,0,4,0"/>
                        <TextBlock Text="? possible"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   VerticalAlignment="Center"
                                   FontSize="11"
                                   Margin="0,0,10,0"/>

                        <Border Width="12"
                                Height="12"
                                Background="{DynamicResource BoardSignalBaitBrush}"
                                BorderBrush="{DynamicResource GridLineBrush}"
                                BorderThickness="1"
                                Margin="0,0,4,0"/>
                        <TextBlock Text="B bait"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   VerticalAlignment="Center"
                                   FontSize="11"/>
                    </WrapPanel>
                </Border>
            </Grid>
        </Border>

        <Grid x:Name="MainContentGrid" Grid.Row="1" Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid x:Name="TopCommandGrid" Grid.Row="0" Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        x:Name="CompactWindowDragHandle"
                        MinWidth="58"
                        Margin="0,0,8,0"
                        Padding="8,5"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource PanelBorderBrush}"
                        BorderThickness="1"
                        Cursor="SizeAll"
                        ToolTip="Drag to move PMG while Board Mode is enabled."
                        MouseLeftButtonDown="CompactWindowDragHandle_MouseLeftButtonDown">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsChecked, ElementName=CompactModeToggleButton}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="Move"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource BodyTextBrush}"
                               FontWeight="SemiBold"
                               TextWrapping="NoWrap"/>
                </Border>

                <Button Grid.Column="2"
                        x:Name="ClearBoardButton"
                        Style="{StaticResource CommandStripButtonStyle}"
                        Margin="0,0,8,0"
                        Content="Clear"
                        Click="ClearBoardButton_Click"/>

                <TextBlock Grid.Column="1"
                           Margin="0,0,16,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource MutedTextBrush}"
                           Text="Right-click a row for pilot details."
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis"/>

                <ToggleButton Grid.Column="3"
                              x:Name="CompactModeToggleButton"
                              Style="{StaticResource CompactModeToggleStyle}"
                              Margin="0,0,8,0"
                              Checked="CompactModeToggleButton_Changed"
                              Unchecked="CompactModeToggleButton_Changed"/>

                <Button Grid.Column="4"
                        x:Name="ExitApplicationButton"
                        Style="{StaticResource CommandStripButtonStyle}"
                        Content="Exit"
                        ToolTip="Exit PMG and stop PMG-owned background work."
                        Click="ExitApplicationButton_Click"/>
            </Grid>

            <TabControl x:Name="MainTabControl"
                        Grid.Row="1"
                        Background="{DynamicResource WindowBackgroundBrush}"
                        BorderBrush="{DynamicResource PanelBorderBrush}"
                        SelectionChanged="MainTabControl_SelectionChanged"
                        ItemContainerStyle="{StaticResource CompactAwareTabItemStyle}">
                <TabItem Header="Analysis">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Padding="12"
                                  Background="{DynamicResource WindowBackgroundBrush}">
                        <StackPanel>
                            <Border Background="{DynamicResource SurfaceAltBrush}"
                                    BorderBrush="{DynamicResource PanelBorderBrush}"
                                    BorderThickness="1"
                                    Padding="16"
                                    Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="EVE Session Context"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource HeaderTextBrush}"
                                               Margin="0,0,0,8"/>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0"
                                                   Grid.Column="0"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   Text="Current character"/>
                                        <TextBlock x:Name="AnalysisCurrentCharacterText"
                                                   Grid.Row="0"
                                                   Grid.Column="1"
                                                   Style="{StaticResource SettingsLabelStyle}"
                                                   Margin="0,0,0,0"
                                                   Foreground="{DynamicResource BodyTextBrush}"
                                                   Text="Not detected"/>

                                        <TextBlock Grid.Row="1"
                                                   Grid.Column="0"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   Text="Current system"/>
                                        <TextBlock x:Name="AnalysisCurrentSystemText"
                                                   Grid.Row="1"
                                                   Grid.Column="1"
                                                   Style="{StaticResource SettingsLabelStyle}"
                                                   Margin="0,0,0,0"
                                                   Foreground="{DynamicResource BodyTextBrush}"
                                                   Text="Not detected"/>

                                        <TextBlock Grid.Row="2"
                                                   Grid.Column="0"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   Text="Evidence source"/>
                                        <TextBlock x:Name="AnalysisEvidenceSourceText"
                                                   Grid.Row="2"
                                                   Grid.Column="1"
                                                   Style="{StaticResource SettingsLabelStyle}"
                                                   Margin="0,0,0,0"
                                                   Foreground="{DynamicResource BodyTextBrush}"
                                                   Text="Not configured"/>

                                        <TextBlock Grid.Row="3"
                                                   Grid.Column="0"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   Text="Last observed"/>
                                        <TextBlock x:Name="AnalysisObservedAtText"
                                                   Grid.Row="3"
                                                   Grid.Column="1"
                                                   Style="{StaticResource SettingsLabelStyle}"
                                                   Margin="0,0,0,0"
                                                   Foreground="{DynamicResource BodyTextBrush}"
                                                   Text="Not detected"/>

                                        <TextBlock Grid.Row="4"
                                                   Grid.Column="0"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   Text="Confidence / status"/>
                                        <TextBlock x:Name="AnalysisContextStatusText"
                                                   Grid.Row="4"
                                                   Grid.Column="1"
                                                   Style="{StaticResource SettingsLabelStyle}"
                                                   Margin="0,0,0,0"
                                                   Foreground="{DynamicResource BodyTextBrush}"
                                                   Text="Unable to infer EVE context"/>
                                    </Grid>
                                    <TextBlock Style="{StaticResource SettingsLabelStyle}"
                                               Margin="0,8,0,0"
                                               Text="Right-click a Grill row to open pilot details. Board Mode keeps the Grill dense for live use; Analysis collects the aggregate readout here."/>
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource SurfaceAltBrush}"
                                    BorderBrush="{DynamicResource PanelBorderBrush}"
                                    BorderThickness="1"
                                    Padding="16">
                                <StackPanel>
                                    <TextBlock Text="Visible Board Analysis"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource HeaderTextBrush}"
                                               Margin="0,0,0,8"/>
                                    <TextBlock x:Name="AnalysisEmptyStateText"
                                               Style="{StaticResource SettingsLabelStyle}"
                                               Text="No visible pilots yet. Load or refresh the Grill to see aggregate analysis."/>
                                    <StackPanel x:Name="AnalysisDetailsPanel"
                                                Visibility="Collapsed">
                                        <TextBlock x:Name="AnalysisVisibleCountsText"
                                                   Style="{StaticResource SettingsLabelStyle}"
                                                   Text="Visible pilots: 0 | Watched pilots: 0"/>
                                        <TextBlock x:Name="AnalysisSignalsText"
                                                   Style="{StaticResource SettingsLabelStyle}"
                                                   Margin="0,2,0,0"
                                                   Text="Confirmed cynos: Hard 0 | Covert 0 | Bait 0"/>
                                        <TextBlock x:Name="AnalysisUniqueCountsText"
                                                   Style="{StaticResource SettingsLabelStyle}"
                                                   Margin="0,8,0,0"
                                                   Text="Unique corps: 0 | Unique alliances: 0"/>
                                        <TextBlock x:Name="AnalysisAllianceTopText"
                                                   Style="{StaticResource SettingsLabelStyle}"
                                                   Margin="0,8,0,0"/>
                                        <TextBlock x:Name="AnalysisCorpTopText"
                                                   Style="{StaticResource SettingsLabelStyle}"
                                                   Margin="0,2,0,0"/>
                                        <TextBlock x:Name="AnalysisHighlightsText"
                                                   Style="{StaticResource SettingsLabelStyle}"
                                                   Margin="0,8,0,0"/>
                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="All alliances"
                                                           Foreground="{DynamicResource MutedTextBrush}"
                                                           Margin="0,0,0,4"/>
                                                <ListBox x:Name="AnalysisAllianceListBox"
                                                         Height="192"
                                                         BorderBrush="{DynamicResource PanelBorderBrush}"
                                                         Background="{DynamicResource SurfaceBrush}"
                                                         Foreground="{DynamicResource BodyTextBrush}"
                                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                         MouseDoubleClick="AnalysisAllianceListBox_MouseDoubleClick">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding DisplayText}"
                                                                       TextWrapping="NoWrap"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Padding="2"/>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="All corps"
                                                           Foreground="{DynamicResource MutedTextBrush}"
                                                           Margin="0,0,0,4"/>
                                                <ListBox x:Name="AnalysisCorpListBox"
                                                         Height="192"
                                                         BorderBrush="{DynamicResource PanelBorderBrush}"
                                                         Background="{DynamicResource SurfaceBrush}"
                                                         Foreground="{DynamicResource BodyTextBrush}"
                                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                         MouseDoubleClick="AnalysisCorpListBox_MouseDoubleClick">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding DisplayText}"
                                                                       TextWrapping="NoWrap"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Padding="2"/>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="Grill">
                    <Grid Background="{DynamicResource WindowBackgroundBrush}">
                        <Grid x:Name="BoardOverlayHost">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60*"/>
                                <ColumnDefinition Width="12*"/>
                                <ColumnDefinition Width="9*"/>
                                <ColumnDefinition Width="649*"/>
                            </Grid.ColumnDefinitions>
                            <DataGrid x:Name="PilotBoard"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      IsReadOnly="True"
                                      SelectionMode="Single"
                                      SelectionUnit="FullRow"
                                      EnableRowVirtualization="True"
                                      EnableColumnVirtualization="True"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                                      Sorting="PilotBoard_Sorting"
                                      ColumnReordered="PilotBoard_ColumnReordered"
                                      SelectionChanged="PilotBoard_SelectionChanged"
                                      MouseDoubleClick="PilotBoard_MouseDoubleClick"
                                      PreviewMouseRightButtonUp="PilotBoard_PreviewMouseRightButtonUp"
                                      PreviewMouseLeftButtonDown="PilotBoard_PreviewMouseLeftButtonDown"
                                      PreviewMouseLeftButtonUp="PilotBoard_PreviewMouseLeftButtonUp"
                                      PreviewMouseMove="PilotBoard_PreviewMouseMove" Grid.ColumnSpan="4">
                                <DataGrid.Resources>
                                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="Transparent"/>
                                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="Transparent"/>
                                </DataGrid.Resources>
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn x:Name="SigColumn" Header="Sig" Width="42" MinWidth="42">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           FontWeight="Bold"
                                                           Text="{Binding BoardSignalIcon}"
                                                           ToolTip="{Binding BoardHoverToolTip}"
                                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=DataGridCell}}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn x:Name="CharacterColumn" Header="Character" SortMemberPath="CharacterName" Width="2*" MinWidth="120">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <DockPanel LastChildFill="True">
                                                    <TextBlock x:Name="WatchedPilotMarker"
                                                               DockPanel.Dock="Left"
                                                               Margin="0,0,6,0"
                                                               VerticalAlignment="Center"
                                                               FontWeight="Bold"
                                                               Foreground="{DynamicResource WatchedPilotMarkerBrush}"
                                                               Text="★"
                                                               Visibility="Collapsed"/>
                                                    <Button x:Name="PilotNoteButton"
                                                            DockPanel.Dock="Right"
                                                            Style="{StaticResource PilotNoteButtonStyle}"
                                                            Content="✎"
                                                            Click="PilotNoteButton_Click"/>
                                                    <TextBlock Text="{Binding CharacterName}"
                                                               VerticalAlignment="Center"
                                                               ToolTip="{Binding BoardHoverToolTip}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </DockPanel>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsWatched}" Value="True">
                                                        <Setter TargetName="WatchedPilotMarker" Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding HasNotes}" Value="True">
                                                        <Setter TargetName="PilotNoteButton" Property="Content" Value="⚑"/>
                                                        <Setter TargetName="PilotNoteButton" Property="ToolTip" Value="View/edit note"/>
                                                        <Setter TargetName="PilotNoteButton" Property="Foreground" Value="{DynamicResource PilotNoteFlagBrush}"/>
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn x:Name="AllianceColumn" Header="Alliance" Binding="{Binding AllianceNameDisplay}" Width="1.8*" MinWidth="120"/>
                                    <DataGridTextColumn x:Name="CorpColumn" Header="Corp" Binding="{Binding CorpNameDisplay}" Width="1.8*" MinWidth="140"/>
                                    <DataGridTextColumn x:Name="KillsColumn" Header="Kills" Binding="{Binding KillCount}" Width="0.9*" MinWidth="55"/>
                                    <DataGridTextColumn x:Name="LossesColumn" Header="Losses" Binding="{Binding LossCount}" Width="0.9*" MinWidth="55"/>
                                    <DataGridTextColumn x:Name="AvgFleetSizeColumn"
                                                        Header="Avg Fleet Size"
                                                        Binding="{Binding AvgAttackersWhenAttacking, StringFormat={}{0:0}}"
                                                        Width="1.2*" MinWidth="70"/>
                                    <DataGridTextColumn x:Name="LastShipSeenColumn" Header="Last Ship Seen" Binding="{Binding LastShipSeenName}" Width="1.8*" MinWidth="100"/>
                                    <DataGridTextColumn x:Name="LastSeenColumn" Header="Last Seen" Binding="{Binding LastShipSeenDateDisplay}" Width="1.2*" MinWidth="90"/>
                                    <DataGridTextColumn x:Name="CynoHullSeenColumn" Header="Cyno Hull Seen" Binding="{Binding LastPublicCynoCapableHull}" Width="1.8*" MinWidth="110"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <Border x:Name="DetailPane"
                                    Visibility="Collapsed"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    Width="300"
                                    Height="380"
                                    Margin="0,0,8,8"
                                    Padding="12"
                                    Background="{DynamicResource SurfaceAltBrush}"
                                    BorderBrush="{DynamicResource PanelBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Panel.ZIndex="10" Grid.Column="3">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0"
                                               Grid.Column="0"
                                               x:Name="SelectedCharacterText"
                                               Text="Selected Character"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource HeaderTextBrush}"
                                               TextWrapping="Wrap"
                                               TextTrimming="None"
                                               Margin="0,0,12,0"/>

                                    <Button Grid.Row="0"
                                            Grid.Column="1"
                                            x:Name="CloseDetailsButton"
                                            Padding="12,4"
                                            Content="Close Details"
                                            Click="CloseDetailsButton_Click"/>

                                    <TextBlock Grid.Row="1"
                                               Grid.ColumnSpan="2"
                                               x:Name="FullCorpText"
                                               Margin="0,12,0,0"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               TextWrapping="Wrap"
                                               Text="Full Corp: --"/>

                                    <TextBlock Grid.Row="2"
                                               Grid.ColumnSpan="2"
                                               x:Name="FullAllianceText"
                                               Margin="0,8,0,0"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               TextWrapping="Wrap"
                                               Text="Full Alliance: --"/>

                                    <TextBlock Grid.Row="3"
                                               Grid.ColumnSpan="2"
                                               x:Name="FreshnessText"
                                               Margin="0,8,0,0"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               TextWrapping="Wrap"
                                               Text="Freshness: --"/>

                                    <TextBlock Grid.Row="4"
                                               Grid.ColumnSpan="2"
                                               x:Name="RecentPublicActivityText"
                                               Margin="0,8,0,0"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               TextWrapping="Wrap"
                                               Text="Recent Public Kill/Loss Activity: --"/>

                                    <TextBlock Grid.Row="5"
                                               Grid.ColumnSpan="2"
                                               x:Name="CynoSignalText"
                                               Margin="0,10,0,4"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource AccentEmberBrush}"
                                               TextWrapping="Wrap"
                                               Text="Cyno Signal: Unknown"/>

                                    <ProgressBar Grid.Row="6"
                                                 Grid.ColumnSpan="2"
                                                 x:Name="CynoConfidenceBar"
                                                 Height="8"
                                                 Minimum="0"
                                                 Maximum="100"
                                                 Value="0"
                                                 Foreground="{DynamicResource AccentEmberBrush}"
                                                 Background="{DynamicResource SurfaceBrush}"
                                                 Margin="0,0,0,6"/>

                                    <TextBlock Grid.Row="7"
                                               Grid.ColumnSpan="2"
                                               x:Name="CynoEvidenceText"
                                               Margin="0,0,0,4"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               TextWrapping="Wrap"
                                               Text="Evidence: --"/>

                                    <TextBlock Grid.Row="8"
                                               Grid.ColumnSpan="2"
                                               x:Name="CynoLimitationsText"
                                               Margin="0,0,0,4"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               TextWrapping="Wrap"
                                               Text="Limitations: --"/>

                                    <TextBlock Grid.Row="9"
                                               Grid.ColumnSpan="2"
                                               x:Name="ExplainabilityText"
                                               Margin="0,8,0,0"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               TextWrapping="Wrap"
                                               Text="Sources / Freshness: --"/>

                                    <Grid Grid.Row="10"
                                          Grid.ColumnSpan="2"
                                          Margin="0,12,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Foreground="{DynamicResource HeaderTextBrush}"
                                                   Text="Notes / Tags"/>

                                        <StackPanel Grid.Column="1"
                                                    Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <Button x:Name="WatchPilotDetailAction"
                                                    Style="{StaticResource DetailActionLinkButtonStyle}"
                                                    Foreground="{DynamicResource SuccessGreenBrush}"
                                                    Content="Watch"
                                                    Click="WatchPilotDetailAction_Click"/>
                                            <CheckBox x:Name="BaitOverrideCheckBox"
                                                      VerticalAlignment="Center"
                                                      Foreground="{DynamicResource BodyTextBrush}"
                                                      Content="Bait"
                                                      Margin="0,0,10,0"
                                                      Checked="BaitOverrideCheckBox_Changed"
                                                      Unchecked="BaitOverrideCheckBox_Changed"/>
                                            <CheckBox x:Name="KnownCynoOverrideCheckBox"
                                                      VerticalAlignment="Center"
                                                      Foreground="{DynamicResource BodyTextBrush}"
                                                      Content="Known-Cyno Override"
                                                      Checked="KnownCynoOverrideCheckBox_Changed"
                                                      Unchecked="KnownCynoOverrideCheckBox_Changed"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Grid.Row="11"
                                          Grid.ColumnSpan="2">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBox Grid.Row="0"
                                                 x:Name="NotesTagsBox"
                                                 Margin="0,0,0,12"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 VerticalScrollBarVisibility="Auto"
                                                 MinHeight="100"/>

                                        <StackPanel Grid.Row="1"
                                                    Orientation="Horizontal"
                                                    HorizontalAlignment="Right">
                                            <Button x:Name="IgnoreAllianceButton"
                                                    Padding="12,6"
                                                    Margin="0,0,8,0"
                                                    Content="Ignore Alliance"
                                                    Click="IgnoreAllianceButton_Click"/>

                                            <Button x:Name="OpenZkillButton"
                                                    Padding="12,6"
                                                    Content="Open zKill"
                                                    Click="OpenZkillButton_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>

                <TabItem Header="Intel">
                    <TabControl Background="{DynamicResource WindowBackgroundBrush}"
                                BorderBrush="{DynamicResource PanelBorderBrush}">
                        <TabItem Header="Status">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          Padding="12"
                                          Background="{DynamicResource WindowBackgroundBrush}">
                                <StackPanel>
                                    <Border x:Name="IntelUpdateBanner"
                                            Background="#155724"
                                            Padding="12,8"
                                            BorderBrush="{DynamicResource PanelBorderBrush}"
                                            BorderThickness="1"
                                            Margin="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock x:Name="IntelUpdateStatusText"
                                                       Foreground="White"
                                                       FontWeight="SemiBold"
                                                       FontSize="16"
                                                       Text="Intel current"/>
                                            <TextBlock x:Name="IntelUpdateDetailText"
                                                       Foreground="#F3F3F3"
                                                       FontSize="12"
                                                       Text="Through latest archive"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="{DynamicResource SurfaceAltBrush}"
                                            BorderBrush="{DynamicResource PanelBorderBrush}"
                                            BorderThickness="1"
                                            Padding="16">
                                        <StackPanel>
                                            <UniformGrid Columns="2"
                                                         Margin="0,0,0,14">
                                                <StackPanel Margin="0,0,12,8">
                                                    <TextBlock Text="Last Updated"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource HeaderTextBrush}"/>
                                                    <TextBlock x:Name="IntelLastUpdatedText"
                                                               Style="{StaticResource SettingsLabelStyle}"
                                                               Margin="0,4,0,0"
                                                               Text="No successful local intel update recorded yet."/>
                                                </StackPanel>

                                                <StackPanel Margin="0,0,0,8">
                                                    <TextBlock Text="Current Update Status"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource HeaderTextBrush}"/>
                                                    <TextBlock x:Name="IntelCurrentUpdateStatusText"
                                                               Style="{StaticResource SettingsLabelStyle}"
                                                               Margin="0,4,0,0"
                                                               Text="No update currently running."/>
                                                </StackPanel>

                                                <StackPanel Margin="0,0,12,8">
                                                    <TextBlock Text="Oldest Killmail Day"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource HeaderTextBrush}"/>
                                                    <TextBlock x:Name="IntelOldestKillmailDayText"
                                                               Style="{StaticResource SettingsLabelStyle}"
                                                               Margin="0,4,0,0"
                                                               Text="No local killmail days recorded yet."/>
                                                </StackPanel>

                                                <StackPanel Margin="0,0,0,8">
                                                    <TextBlock Text="Newest Killmail Day"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource HeaderTextBrush}"/>
                                                    <TextBlock x:Name="IntelNewestKillmailDayText"
                                                               Style="{StaticResource SettingsLabelStyle}"
                                                               Margin="0,4,0,0"
                                                               Text="No local killmail days recorded yet."/>
                                                </StackPanel>
                                            </UniformGrid>

                                            <TextBlock Text="Total Update Progress"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource HeaderTextBrush}"/>
                                            <ProgressBar x:Name="IntelTotalProgressBar"
                                                         Height="16"
                                                         Margin="0,6,0,4"
                                                         Minimum="0"
                                                         Maximum="100"
                                                         Value="0"/>
                                            <TextBlock x:Name="IntelTotalProgressText"
                                                       Style="{StaticResource SettingsLabelStyle}"
                                                       Margin="0,0,0,12"
                                                       Text="No catch-up update is currently required."/>

                                            <TextBlock Text="Current-Day Progress"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource HeaderTextBrush}"/>
                                            <ProgressBar x:Name="IntelCurrentDayProgressBar"
                                                         Height="16"
                                                         Margin="0,6,0,4"
                                                         Minimum="0"
                                                         Maximum="100"
                                                         Value="0"/>
                                            <TextBlock x:Name="IntelCurrentDayProgressText"
                                                       Style="{StaticResource SettingsLabelStyle}"
                                                       Margin="0,0,0,0"
                                                       Text="No update currently running."/>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="{DynamicResource SurfaceAltBrush}"
                                            BorderBrush="{DynamicResource PanelBorderBrush}"
                                            BorderThickness="1"
                                            Padding="16"
                                            Margin="0,12,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Live zKill Feed"
                                                       FontSize="18"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource HeaderTextBrush}"
                                                       Margin="0,0,0,12"/>

                                            <UniformGrid Columns="2"
                                                         Margin="0,0,0,0">
                                                <StackPanel Margin="0,0,12,8">
                                                    <TextBlock Text="Source"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource HeaderTextBrush}"/>
                                                    <TextBlock x:Name="IntelLiveFeedSourceText"
                                                               Style="{StaticResource SettingsLabelStyle}"
                                                               Margin="0,4,0,0"
                                                               Text="R2Z2"/>
                                                </StackPanel>

                                                <StackPanel Margin="0,0,0,8">
                                                    <TextBlock Text="Status"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource HeaderTextBrush}"/>
                                                    <TextBlock x:Name="IntelLiveFeedStatusText"
                                                               Style="{StaticResource SettingsLabelStyle}"
                                                               Margin="0,4,0,0"
                                                               Text="Disabled"/>
                                                </StackPanel>

                                                <StackPanel Margin="0,0,12,8">
                                                    <TextBlock Text="Enabled"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource HeaderTextBrush}"/>
                                                    <TextBlock x:Name="IntelLiveFeedEnabledText"
                                                               Style="{StaticResource SettingsLabelStyle}"
                                                               Margin="0,4,0,0"
                                                               Text="No"/>
                                                </StackPanel>

                                                <StackPanel Margin="0,0,0,8">
                                                    <TextBlock Text="Recent Live Imports"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource HeaderTextBrush}"/>
                                                    <TextBlock x:Name="IntelLiveFeedRecentImportsText"
                                                               Style="{StaticResource SettingsLabelStyle}"
                                                               Margin="0,4,0,0"
                                                               Text="0"/>
                                                </StackPanel>

                                                <StackPanel Margin="0,0,12,8">
                                                    <TextBlock Text="Next Sequence"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource HeaderTextBrush}"/>
                                                    <TextBlock x:Name="IntelLiveFeedNextSequenceText"
                                                               Style="{StaticResource SettingsLabelStyle}"
                                                               Margin="0,4,0,0"
                                                               Text="Not initialized"/>
                                                </StackPanel>

                                                <StackPanel Margin="0,0,0,8">
                                                    <TextBlock Text="Last Processed Sequence"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource HeaderTextBrush}"/>
                                                    <TextBlock x:Name="IntelLiveFeedLastProcessedSequenceText"
                                                               Style="{StaticResource SettingsLabelStyle}"
                                                               Margin="0,4,0,0"
                                                               Text="None"/>
                                                </StackPanel>

                                                <StackPanel Margin="0,0,12,8">
                                                    <TextBlock Text="Last Successful Live Import"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource HeaderTextBrush}"/>
                                                    <TextBlock x:Name="IntelLiveFeedLastSuccessText"
                                                               Style="{StaticResource SettingsLabelStyle}"
                                                               Margin="0,4,0,0"
                                                               Text="No live imports recorded yet."/>
                                                </StackPanel>

                                                <StackPanel Margin="0,0,0,8">
                                                    <TextBlock Text="Last Caught Up / Waiting"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource HeaderTextBrush}"/>
                                                    <TextBlock x:Name="IntelLiveFeedLastCaughtUpText"
                                                               Style="{StaticResource SettingsLabelStyle}"
                                                               Margin="0,4,0,0"
                                                               Text="No caught-up wait recorded yet."/>
                                                </StackPanel>
                                            </UniformGrid>

                                            <TextBlock Text="Last Error"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource HeaderTextBrush}"
                                                       Margin="0,4,0,0"/>
                                            <TextBlock x:Name="IntelLiveFeedLastErrorText"
                                                       Style="{StaticResource SettingsLabelStyle}"
                                                       Margin="0,4,0,0"
                                                       TextWrapping="Wrap"
                                                       Text="No live-feed errors recorded."/>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="{DynamicResource SurfaceAltBrush}"
                                            BorderBrush="{DynamicResource PanelBorderBrush}"
                                            BorderThickness="1"
                                            Padding="16"
                                            Margin="0,12,0,0">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,12">
                                                <TextBlock Text="Today's Freshness"
                                                           FontSize="18"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource HeaderTextBrush}"
                                                           VerticalAlignment="Center"/>
                                                <Button x:Name="RunTodaysFreshnessButton"
                                                        DockPanel.Dock="Right"
                                                        Width="200"
                                                        Padding="14,6"
