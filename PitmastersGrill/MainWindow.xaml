                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource AccentEmberBrush}"
                                               TextWrapping="Wrap"
                                               Text="Cyno Signal: Unknown" AutomationProperties.AutomationId="CynoSignalText"/>

                                    <ProgressBar Grid.Row="6"
