                                               Margin="0,0,0,4"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               TextWrapping="Wrap"
                                               Text="Evidence: --" AutomationProperties.AutomationId="CynoEvidenceText"/>

                                    <TextBlock Grid.Row="8"
