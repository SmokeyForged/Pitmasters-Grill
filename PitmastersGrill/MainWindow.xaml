                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource HeaderTextBrush}"/>
                                                    <TextBlock x:Name="HistoricalFreshnessPilotsCheckedText"
                                                               Style="{StaticResource SettingsLabelStyle}"
                                                               Margin="0,4,0,0"
                                                               Text="0"/>
                                                </StackPanel>

                                                <StackPanel Margin="0,0,12,8">
                                                    <TextBlock Text="Historical Days Checked"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource HeaderTextBrush}"/>
                                                    <TextBlock x:Name="HistoricalFreshnessDaysCheckedText"
                                                               Style="{StaticResource SettingsLabelStyle}"
                                                               Margin="0,4,0,0"
                                                               Text="0"/>
                                                </StackPanel>

                                                <StackPanel Margin="0,0,0,8">
                                                    <TextBlock Text="Entities Queried"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource HeaderTextBrush}"/>
                                                    <TextBlock x:Name="HistoricalFreshnessEntitiesQueriedText"
                                                               Style="{StaticResource SettingsLabelStyle}"
                                                               Margin="0,4,0,0"
                                                               Text="0"/>
                                                </StackPanel>

                                                <StackPanel Margin="0,0,12,8">
                                                    <TextBlock Text="zKill Results Found"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource HeaderTextBrush}"/>
                                                    <TextBlock x:Name="HistoricalFreshnessResultsFoundText"
                                                               Style="{StaticResource SettingsLabelStyle}"
                                                               Margin="0,4,0,0"
                                                               Text="0"/>
                                                </StackPanel>

                                                <StackPanel Margin="0,0,0,8">
                                                    <TextBlock Text="Already Known / Skipped"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource HeaderTextBrush}"/>
                                                    <TextBlock x:Name="HistoricalFreshnessKnownSkippedText"
                                                               Style="{StaticResource SettingsLabelStyle}"
                                                               Margin="0,4,0,0"
                                                               Text="0"/>
                                                </StackPanel>

                                                <StackPanel Margin="0,0,12,8">
                                                    <TextBlock Text="Missing Imported"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource HeaderTextBrush}"/>
                                                    <TextBlock x:Name="HistoricalFreshnessImportedText"
                                                               Style="{StaticResource SettingsLabelStyle}"
                                                               Margin="0,4,0,0"
                                                               Text="0"/>
                                                </StackPanel>

                                                <StackPanel Margin="0,0,0,8">
                                                    <TextBlock Text="Failed"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource HeaderTextBrush}"/>
                                                    <TextBlock x:Name="HistoricalFreshnessFailedText"
                                                               Style="{StaticResource SettingsLabelStyle}"
                                                               Margin="0,4,0,0"
                                                               Text="0"/>
                                                </StackPanel>

                                                <StackPanel Margin="0,0,12,8">
                                                    <TextBlock Text="Last Run"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource HeaderTextBrush}"/>
                                                    <TextBlock x:Name="HistoricalFreshnessLastRunText"
                                                               Style="{StaticResource SettingsLabelStyle}"
                                                               Margin="0,4,0,0"
                                                               Text="No Historical Freshness run recorded yet."/>
                                                </StackPanel>
                                            </UniformGrid>

                                            <TextBlock Text="Details"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource HeaderTextBrush}"
                                                       Margin="0,4,0,0"/>
                                            <TextBlock x:Name="HistoricalFreshnessDetailText"
                                                       Style="{StaticResource SettingsLabelStyle}"
                                                       Margin="0,4,0,0"
                                                       TextWrapping="Wrap"
                                                       Text="Historical Freshness is idle."/>

                                            <TextBlock Text="Last Error"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource HeaderTextBrush}"
                                                       Margin="0,10,0,0"/>
                                            <TextBlock x:Name="HistoricalFreshnessLastErrorText"
                                                       Style="{StaticResource SettingsLabelStyle}"
                                                       Margin="0,4,0,0"
