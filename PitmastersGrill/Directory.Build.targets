<Project>
  <Target Name="Pmg28ComposeCutover"
          BeforeTargets="BeforeBuild"
          Condition="'$(GITHUB_ACTIONS)' == 'true' and '$(GITHUB_EVENT_NAME)' == 'pull_request' and '$(GITHUB_HEAD_REF)' == 'feature/pmg-18-external-navigation-version'">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)..\.github\scripts\pmg28-compose-cutover.ps1&quot;" />
  </Target>
</Project>
