<UserControl x:Class="PitmastersGrill.Views.HelpView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="560"
             d:DesignWidth="720"
             AutomationProperties.AutomationId="HelpView">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/PitmastersGrill;component/Resources/MainWindowResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <TabControl x:Name="HelpTabControl"
                Style="{StaticResource PmgNestedSubTabControlStyle}"
                Background="#101418"
                BorderBrush="#3A4652"
                Foreground="#F2EFE6"
                AutomationProperties.AutomationId="HelpTabControl">
        <TabItem Header="General / Getting Started"
                 Style="{StaticResource PmgNestedSubTabItemStyle}"
                 Background="#1E252C"
                 Foreground="#F2EFE6"
                 AutomationProperties.AutomationId="HelpGeneralTab">
            <ScrollViewer x:Name="GeneralHelpOuterScrollViewer"
                          VerticalScrollBarVisibility="Auto"
                          Background="#101418"
                          PreviewMouseWheel="NestedScrollViewer_PreviewMouseWheel"
                          AutomationProperties.AutomationId="GeneralHelpOuterScrollViewer">
                <StackPanel Margin="8" Background="#101418">
                    <ScrollViewer x:Name="GeneralHelpInnerScrollViewer"
                                  VerticalScrollBarVisibility="Auto"
                                  Background="#101418"
                                  PreviewMouseWheel="NestedScrollViewer_PreviewMouseWheel"
                                  AutomationProperties.AutomationId="GeneralHelpInnerScrollViewer">
                        <StackPanel Margin="16">
                            <TextBlock Text="PMG Help"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource HeaderTextBrush}"
                                       Margin="0,0,0,6"
                                       AutomationProperties.AutomationId="HelpHeading"/>
                            <TextBlock Text="Quick reference for common PMG shortcuts and interactions."
                                       Style="{StaticResource SettingsLabelStyle}"
                                       Margin="0,0,0,16"/>

                            <Border Background="{DynamicResource SurfaceAltBrush}"
                                    BorderBrush="{DynamicResource PanelBorderBrush}"
                                    BorderThickness="1"
                                    Padding="14"
                                    Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Keyboard Shortcuts"
                                               FontSize="17"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource HeaderTextBrush}"
                                               Margin="0,0,0,8"/>
                                    <TextBlock Text="Insert — Toggle Board Mode on or off. If PMG switches into the dense live board layout, press Insert again to return to normal mode."
                                               Style="{StaticResource SettingsLabelStyle}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,6"/>
                                    <TextBlock Text="Delete — Clear the current Grill board."
                                               Style="{StaticResource SettingsLabelStyle}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,6"/>
                                    <TextBlock Text="Home — Reprocess the current clipboard contents and refresh the Grill if the clipboard contains a valid EVE Local list."
                                               Style="{StaticResource SettingsLabelStyle}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,6"/>
                                    <TextBlock Text="Ctrl+Home — Reset and recover the PMG window position/size if it is moved off-screen or the layout gets awkward. PMG also attempts to register this as a global hotkey while the app is running."
                                               Style="{StaticResource SettingsLabelStyle}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,6"/>
                                    <TextBlock Text="Esc three times quickly — Exit PMG."
                                               Style="{StaticResource SettingsLabelStyle}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,6"/>
                                    <TextBlock Text="Esc in Pilot Detail or Pilot Notes windows — Close that window."
                                               Style="{StaticResource SettingsLabelStyle}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,6"/>
                                    <TextBlock Text="Ctrl+S in the Pilot Notes window — Save the note and close the window."
                                               Style="{StaticResource SettingsLabelStyle}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,6"/>
                                    <TextBlock Text="Panel Mode — PMG uses the compact panel-style window by default."
                                               Style="{StaticResource SettingsLabelStyle}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource SurfaceAltBrush}"
                                    BorderBrush="{DynamicResource PanelBorderBrush}"
                                    BorderThickness="1"
                                    Padding="14"
                                    Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Grill"
                                               FontSize="17"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource HeaderTextBrush}"
                                               Margin="0,0,0,8"/>
                                    <TextBlock Text="Copy EVE Local — PMG watches the clipboard and populates Grill when it sees a valid EVE Local pilot list."
                                               Style="{StaticResource SettingsLabelStyle}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,6"/>
                                    <TextBlock Text="Right-click any Grill row — Open pilot details."
                                               Style="{StaticResource SettingsLabelStyle}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,6"/>
                                    <TextBlock Text="Board display options — Use Settings -> Board Columns to hide grid lines, shrink text safely, or switch the Grill board font for a denser view."
                                               Style="{StaticResource SettingsLabelStyle}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,6"/>
                                    <TextBlock Text="Double-click a Grill row — Open that pilot on zKillboard."
                                               Style="{StaticResource SettingsLabelStyle}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,6"/>
                                    <TextBlock Text="Column layout — Drag column headers to reorder, drag separators to resize, and use Settings → Board Columns to show/hide or reset columns."
                                               Style="{StaticResource SettingsLabelStyle}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource SurfaceAltBrush}"
                                    BorderBrush="{DynamicResource PanelBorderBrush}"
                                    BorderThickness="1"
                                    Padding="14"
                                    Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Analysis"
                                               FontSize="17"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource HeaderTextBrush}"
                                               Margin="0,0,0,8"/>
                                    <TextBlock Text="Double-click supported pilots, corporations, or alliances in Analysis lists — Open the matching zKillboard page."
                                               Style="{StaticResource SettingsLabelStyle}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,6"/>
                                    <TextBlock Text="EVE Session Context — PMG can infer character/system context from local-only EVE window/log evidence when available."
                                               Style="{StaticResource SettingsLabelStyle}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource SurfaceAltBrush}"
                                    BorderBrush="{DynamicResource PanelBorderBrush}"
                                    BorderThickness="1"
                                    Padding="14"
                                    Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Intel Freshness"
                                               FontSize="17"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource HeaderTextBrush}"
                                               Margin="0,0,0,8"/>
                                    <TextBlock Text="Today’s Freshness — Checks visible pilots for recent same-day zKill-known killmails that may not have arrived through the live feed yet."
                                               Style="{StaticResource SettingsLabelStyle}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,6"/>
                                    <TextBlock Text="Historical Freshness — Checks visible pilots for missing zKill-known killmails from recent completed UTC days."
                                               Style="{StaticResource SettingsLabelStyle}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,6"/>
                                    <TextBlock Text="Background Historical Repair — If enabled, PMG runs a bounded repair pass after startup using local known pilots and cooldown protection."
                                               Style="{StaticResource SettingsLabelStyle}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,6"/>
                                    <TextBlock Text="R2Z2 Live zKill Feed — Optional live zKill-known killmail feed. It is separate from daily archive backfill and freshness repair."
                                               Style="{StaticResource SettingsLabelStyle}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource SurfaceAltBrush}"
                                    BorderBrush="{DynamicResource PanelBorderBrush}"
                                    BorderThickness="1"
                                    Padding="14">
                                <StackPanel>
                                    <TextBlock Text="Diagnostics"
                                               FontSize="17"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource HeaderTextBrush}"
                                               Margin="0,0,0,8"/>
                                    <TextBlock Text="Settings → Diagnostics — Open logs or package diagnostics for troubleshooting provider, clipboard, import, database, freshness, and UI issues."
                                               Style="{StaticResource SettingsLabelStyle}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <TabItem Header="Signal Reference"
                 Style="{StaticResource PmgNestedSubTabItemStyle}"
                 Background="#1E252C"
                 Foreground="#F2EFE6"
                 AutomationProperties.AutomationId="HelpSignalReferenceTab">
            <ScrollViewer x:Name="SignalReferenceScrollViewer"
                          VerticalScrollBarVisibility="Auto"
                          Background="#101418"
                          PreviewMouseWheel="NestedScrollViewer_PreviewMouseWheel"
                          AutomationProperties.AutomationId="SignalReferenceScrollViewer">
                <StackPanel Margin="8" Background="#101418">
                    <TextBlock Text="PMG Signal Reference"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#F2EFE6"
                               Margin="0,0,0,8"
                               AutomationProperties.AutomationId="SignalReferenceHeading"/>
                    <TextBlock Text="PMG signals are public historical evidence summaries. They do not prove that a pilot is currently in that ship, currently fit that way, uncloaked, on-grid, or actively baiting. PMG summarizes public evidence so users can make better decisions; it does not make live-certainty claims."
                               TextWrapping="Wrap"
                               Foreground="#F2EFE6"
                               Margin="0,0,0,12"/>

                    <TextBlock Text="Confirmed covert" FontWeight="SemiBold" Foreground="#F2EFE6" Margin="0,8,0,2"/>
                    <TextBlock Text="PMG found recent public killmail-derived module evidence showing a Covert Cynosural Field Generator I." TextWrapping="Wrap" Foreground="#F2EFE6"/>

                    <TextBlock Text="Confirmed normal" FontWeight="SemiBold" Foreground="#F2EFE6" Margin="0,8,0,2"/>
                    <TextBlock Text="PMG found recent public killmail-derived module evidence showing a regular Cynosural Field Generator I. In code this is the normal cyno type; in one UI/context it may also display as hard." TextWrapping="Wrap" Foreground="#F2EFE6"/>

                    <TextBlock Text="Possible" FontWeight="SemiBold" Foreground="#F2EFE6" Margin="0,8,0,2"/>
                    <TextBlock Text="PMG has meaningful evidence, but not enough for recent confirmed module evidence. This can come from stale or unknown-age module evidence, or from combined weaker signals." TextWrapping="Wrap" Foreground="#F2EFE6"/>

                    <TextBlock Text="Inferred" FontWeight="SemiBold" Foreground="#F2EFE6" Margin="0,8,0,2"/>
                    <TextBlock Text="Weak evidence exists, usually from cyno-capable hull observations, public activity, or related context, but no confirmed cyno module was found." TextWrapping="Wrap" Foreground="#F2EFE6"/>

                    <TextBlock Text="Bait" FontWeight="SemiBold" Foreground="#F2EFE6" Margin="0,8,0,2"/>
                    <TextBlock Text="PMG found public loss evidence where an industrial cyno and a tackle module, such as a warp scrambler or warp disruptor, appeared together. This suggests possible industrial cyno bait, but it is still evidence-based and not proof of intent." TextWrapping="Wrap" Foreground="#F2EFE6"/>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
    </TabControl>
</UserControl>
