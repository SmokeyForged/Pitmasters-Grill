<Window x:Class="PitmastersGrill.Views.PilotDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PMG Details"
        Width="430"
        Height="360"
        MinWidth="380"
        MinHeight="280"
        WindowStartupLocation="Manual"
        Background="{DynamicResource WindowBackgroundBrush}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="DetailLinkButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,14,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock x:Name="Text"
                                   Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                                   Foreground="{TemplateBinding Foreground}"
                                   FontWeight="{TemplateBinding FontWeight}"
                                   TextDecorations="{x:Null}"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Text" Property="TextDecorations" Value="Underline"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Text" Property="Foreground" Value="{DynamicResource ErrorRedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="8"
            Padding="10"
            Background="{DynamicResource SurfaceAltBrush}"
            BorderBrush="{DynamicResource PanelBorderBrush}"
            BorderThickness="1"
            CornerRadius="4">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock x:Name="PilotNameText"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource HeaderTextBrush}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,4"/>

                <TextBlock x:Name="AffiliationText"
                           Foreground="{DynamicResource BodyTextBrush}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,2"/>

                <TextBlock x:Name="ActivityText"
                           Foreground="{DynamicResource MutedTextBrush}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,2"/>

                <TextBlock x:Name="KillLossText"
                           Foreground="{DynamicResource MutedTextBrush}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,10"/>

                <WrapPanel Margin="0,0,0,8">
                    <Button x:Name="KnownCynoOverrideLink"
                            Style="{StaticResource DetailLinkButtonStyle}"
                            Content="Known-Cyno Override"
                            Click="KnownCynoOverrideLink_Click"/>
                    <Button x:Name="BaitOverrideLink"
                            Style="{StaticResource DetailLinkButtonStyle}"
                            Content="Bait"
                            Click="BaitOverrideLink_Click"/>
                </WrapPanel>

                <TextBlock x:Name="BaitSignalText"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource BoardSignalBaitBrush}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,2"/>

                <TextBlock x:Name="CynoSignalText"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentAshBrush}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,2"/>

                <TextBlock x:Name="EvidenceText"
                           Foreground="{DynamicResource BodyTextBrush}"
                           TextWrapping="Wrap"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,0,0,2"/>

                <TextBlock x:Name="LimitationsText"
                           Foreground="{DynamicResource MutedTextBrush}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8"/>

                <TextBlock x:Name="BottomFreshnessText"
                           Foreground="{DynamicResource MutedTextBrush}"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Margin="0,2,0,0"/>
            </StackPanel>

            <WrapPanel Grid.Row="1"
                       HorizontalAlignment="Right"
                       Margin="0,10,0,0">
                <Button x:Name="IgnorePilotLink"
                        Style="{StaticResource DetailLinkButtonStyle}"
                        Content="Ignore Pilot"
                        Click="IgnorePilotLink_Click"/>
                <Button x:Name="IgnoreCorpLink"
                        Style="{StaticResource DetailLinkButtonStyle}"
                        Content="Ignore Corp"
                        Click="IgnoreCorpLink_Click"/>
                <Button x:Name="IgnoreAllianceLink"
                        Style="{StaticResource DetailLinkButtonStyle}"
                        Content="Ignore Alliance"
                        Click="IgnoreAllianceLink_Click"/>
                <Button x:Name="OpenZkillLink"
                        Style="{StaticResource DetailLinkButtonStyle}"
                        Content="Open zKill"
                        Click="OpenZkillLink_Click"/>
                <Button x:Name="CloseLink"
                        Style="{StaticResource DetailLinkButtonStyle}"
                        Content="Close"
                        Click="CloseLink_Click"/>
            </WrapPanel>
        </Grid>
    </Border>
</Window>
